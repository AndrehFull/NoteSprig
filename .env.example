# Local development is bound to 127.0.0.1 and uses NOTESPRIG_DEV_PASSWORD.
HOST=127.0.0.1
PORT=4317
NOTESPRIG_VAULT=./data/vault
NOTESPRIG_DEV_PASSWORD=replace-this-local-password

# Production needs no credentials here. On first start, NoteSprig prints a setup code in its log
# (`docker compose logs notesprig`); open the app, enter the code, and create your password.
# Optional for managed deployments: a hash from `npm run set-password` (keep the single quotes)
# and a random secret of at least 32 characters. When set, they take precedence.
# NOTESPRIG_PASSWORD_HASH='scrypt$...'
# SESSION_SECRET=

# Image version for Docker Compose (see GitHub releases). `latest` follows stable releases;
# `edge` follows the main branch. Pinning a version makes updates and rollbacks explicit.
NOTESPRIG_VERSION=latest
