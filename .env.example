# Local development is bound to 127.0.0.1 and uses NOTESPRIG_DEV_PASSWORD.
HOST=127.0.0.1
PORT=4317
NOTESPRIG_VAULT=./data/vault
NOTESPRIG_DEV_PASSWORD=replace-this-local-password

# Production behind HTTPS: run `npm run set-password` and set both values.
NOTESPRIG_PASSWORD_HASH=configure-with-npm-run-set-password
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# For Docker Compose on the VPS, replace both production values before starting.
