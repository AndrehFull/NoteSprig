{
  "name": "notesprig",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run prepare:boards && tsc -b && vite build && node scripts/build-pwa.mjs",
    "start": "node server/index.mjs",
    "set-password": "node scripts/set-password.mjs",
    "test:ui": "npm run build && playwright test",
    "check:docs": "node scripts/check-docs.mjs",
    "notices:generate": "node scripts/third-party-notices.mjs",
    "notices:check": "node scripts/third-party-notices.mjs --check",
    "check:i18n": "node scripts/check-i18n.mjs",
    "prepare:boards": "node scripts/prepare-board-assets.mjs",
    "predev": "npm run prepare:boards"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@excalidraw/excalidraw": "0.18.1",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.1",
    "d3-force": "^3.0.1",
    "dompurify": "^3.4.18",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "jsep": "^1.6.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.77.0",
    "marked": "^18.2.1",
    "mermaid": "^12.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "0.35.5",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/d3-force": "^3.0.10",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.18.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Self-hosted linked notes, knowledge graphs, and visual thinking.",
  "keywords": [
    "markdown",
    "note-taking",
    "knowledge-management",
    "self-hosted",
    "pwa"
  ],
  "overrides": {
    "lodash-es": "4.18.1",
    "nanoid@>=3.0.0 <4.0.0": "3.3.20",
    "nanoid@>=4.0.0 <6.0.0": "5.1.16",
    "picomatch": "4.0.7",
    "katex": "$katex",
    "@excalidraw/excalidraw": {
      "@radix-ui/react-tabs": "1.2.1"
    }
  }
}
